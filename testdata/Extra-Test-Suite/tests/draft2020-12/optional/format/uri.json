[
    {
        "description": "validation of uri strings",
        "schema": { "format": "uri" },
        "tests": [
            {
                "description": "ok",
                "data": "https://example.org/",
                "valid": true
            },
            {
                "description": "invalid userinfo",
                "data": "https://[@example.org/test.txt",
                "valid": false
            },
            {
                "description": "unescape non US-ASCII characters",
                "data": "https://example.org/foobar®.txt",
                "valid": false
            }
        ]
    }
]
